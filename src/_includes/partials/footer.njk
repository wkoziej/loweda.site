<footer class="footer mt-auto py-4 bg-light">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-md-6 text-center text-md-start">
        <h5 class="text-primary mb-3">{{ site.name }}</h5>
        <p class="text-muted small mb-0">{{ site.description }}</p>
        <p class="text-muted small mb-0">{{ site.address }}</p>
      </div>
      <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
        <div class="social-links">
          {% if site.social.facebook %}
          <a href="{{ site.social.facebook }}" target="_blank" class="text-decoration-none me-3" title="Facebook">
            <i class="bi bi-facebook fs-4"></i>
          </a>
          {% endif %}
        </div>
        <p class="text-muted small mt-2 mb-0">&copy; {{ site.name }} {% year %}. Wszelkie prawa zastrzeżone.</p>
      </div>
    </div>
  </div>
</footer> 